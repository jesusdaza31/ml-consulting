# =============================================
# Supabase
# =============================================
# Obtener de: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
SUPABASE_SECRET_KEY=tu-secret-key
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# =============================================
# Cloudflare R2 (videos y documentos)
# =============================================
# Obtener de: https://dash.cloudflare.com/?to=/r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ml-consulting-videos

# Opcional: host público del bucket (dominio conectado en R2)
# Vacío = siempre URL firmadas de corta duración
R2_PUBLIC_HOST=

# =============================================
# Admin (para seed inicial)
# =============================================
ADMIN_EMAIL=admin@mlconsulting.com
ADMIN_PASSWORD=CambiaEstaContraseña123!
