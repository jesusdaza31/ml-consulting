{
  "version": 2,
  "builds": [
    {
      "src": "api/admin.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/client.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/admin(/.*)?",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/auth(/.*)?",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/client(/.*)?",
      "dest": "/api/client.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
