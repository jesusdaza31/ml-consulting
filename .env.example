# Credenciales del administrador (¡cámbialas antes de producción!)
ADMIN_EMAIL=admin@mlconsulting.com
ADMIN_PASSWORD=Admin1234!

# Secreto para firmar las sesiones.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Puerto opcional (por defecto 3000)
# PORT=3000

# =============================================
# Cloudflare R2 (videos)
# =============================================
# Pasos manuales (una sola vez, en dash.cloudflare.com):
#   1. Crea una cuenta en Cloudflare (gratuita).
#   2. Ve a R2 > Crear bucket. Nombre sugerido: ml-consulting-videos.
#   3. En R2 > Administrar tokens de API > Crear token de API:
#      - Permisos: "Objeto de lectura y escritura" (Object Read & Write)
#      - Ámbito: el bucket creado (por ejemplo ml-consulting-videos).
#   4. Copia los 3 valores: el ID de cuenta, el Access Key ID y el
#      Secret Access Key del token.
#   5. Pégalos abajo. El Account ID está en la página de R2 (esquina superior).
# Si estas variables faltan, la sección Videos muestra "R2 no configurado"
# y los cursos siguen usando videos de YouTube normalmente.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ml-consulting-videos

# Opcional: host público del bucket (dominio conectado en R2).
# Vacío = siempre URL firmadas de corta duración.
R2_PUBLIC_HOST=
